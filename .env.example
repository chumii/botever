# Kopie als .env.dev (Entwicklung) bzw. .env.prod (Produktion) anlegen und ausfüllen.

# --- Discord ---
# Bot-Token aus dem Discord Developer Portal (Bot > Token)
DISCORD_TOKEN=
# Application ID der Discord-App
DISCORD_CLIENT_ID=
# Server-ID, auf dem die Slash-Commands registriert werden
DISCORD_GUILD_ID=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- WoWUtils ---
# Gruppen-API-Key aus den WoWUtils-Gruppeneinstellungen. Ein Admin muss den
# API-Zugriff freischalten; der Key wird nur einmal angezeigt.
WOWUTILS_API_KEY=

# --- Abmeldungen ---
# Channel, in den Abmeldungen protokolliert werden
ABMELDUNGEN_LOG_CHANNEL=
# Channel für allgemeine Ankündigungen
ANN_CHANNEL=

# --- Voice Monitor ---
# Voice-Channel, der überwacht wird
VOICE_MONITOR_CHANNEL=
# Text-Channel, in den Join/Leave gemeldet wird
VOICE_ANN_CHANNEL=

# --- LFG / Forum Monitor ---
# Forum-Channel, dessen Threads überwacht werden
FORUM_SOURCE_CHANNEL=
# Text-Channel für Thread-Ankündigungen
FORUM_ANNOUNCE_CHANNEL=
# Alter in Tagen, ab dem Threads automatisch gelöscht werden
FORUM_CLEANUP_DAYS=
# Tag-Name, der einen Thread zum Löschen markiert
FORUM_DONE_TAG_NAME=
# Tag-Name, der einen Thread vom Löschen ausnimmt
FORUM_NO_DELETE_TAG_NAME=
